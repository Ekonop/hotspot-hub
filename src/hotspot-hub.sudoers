# Passwordless privileged actions for Hotspot Hub (wheel group).
# Scoped to exact binaries/args only - no blanket NOPASSWD.
%wheel ALL=(root) NOPASSWD: /usr/bin/iw phy * interface add ap0 type __ap
%wheel ALL=(root) NOPASSWD: /usr/bin/ip link set ap0 *
%wheel ALL=(root) NOPASSWD: /usr/bin/iw dev ap0 station del *
%wheel ALL=(root) NOPASSWD: /usr/bin/systemctl restart hotspot-channelsync.service
%wheel ALL=(root) NOPASSWD: /usr/bin/systemctl status hotspot-channelsync.service
%wheel ALL=(root) NOPASSWD: /usr/bin/systemctl is-active hotspot-channelsync.service
%wheel ALL=(root) NOPASSWD: /usr/bin/cat /var/lib/NetworkManager/dnsmasq-ap0.leases
%wheel ALL=(root) NOPASSWD: /usr/bin/nft list *
%wheel ALL=(root) NOPASSWD: /usr/local/bin/hotspot-channelsync.sh
%wheel ALL=(root) NOPASSWD: /usr/bin/touch /run/hotspot-hub-disabled
%wheel ALL=(root) NOPASSWD: /usr/bin/rm -f /run/hotspot-hub-disabled
%wheel ALL=(root) NOPASSWD: /usr/bin/sysctl -w net.ipv6.conf.ap0.disable_ipv6=*
%wheel ALL=(root) NOPASSWD: /usr/bin/tc qdisc *
