# Maintainer: vansh
pkgname=hotspot-hub
pkgver=0.6.1
pkgrel=1
pkgdesc="KDE tray control for concurrent Wi-Fi hotspot, WARP and channel-sync"
arch=('any')
url="https://example.local/hotspot-hub"
license=('MIT')
install=hotspot-hub.install
depends=('networkmanager' 'iw' 'iproute2' 'polkit' 'python-flet' 'python-pystray' 'python-pillow')
optdepends=('python-pyqt6: legacy Qt dropdown canvas support'
            'warp-cli: Cloudflare WARP status/toggle in tray'
            'ufw: firewall rules for hotspot DHCP/NAT')
source=('hotspot-hub.py'
        'hotspot-hub-tray.py'
        'hotspot-hub-flet.py'
        'hotspot-hub-flet.sh'
        'hotspot-hub-cli.py'
        'hotspot-on.sh'
        'hotspot-off.sh'
        'hotspot-channelsync.sh'
        '90-hotspot-channelsync'
        'hotspot-channelsync.service'
        '99-hotspot.conf'
        '99-hotspot-powersave.conf'
        'hotspot-hub.sudoers'
        'hotspot-hub.svg'
        'hotspot-hub.desktop'
        'hotspot-hub-flet.desktop'
        'hotspot-hub-qt.desktop'
        'setup-profile.sh'
        'core/__init__.py'
        'core/config.py'
        'core/services.py')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  cd "$srcdir"
  # Main app: launcher (defaults to Flet, --legacy-qt fallback)
  cat <<'EOF' > hotspot-hub-launcher
#!/usr/bin/env bash
if [ "${HOTSPOT_HUB_UI:-}" = "qt" ] || [ "${1:-}" = "--legacy-qt" ] || [ "${1:-}" = "--qt" ]; then
  [ "${1:-}" = "--legacy-qt" ] || [ "${1:-}" = "--qt" ] && shift
  exec /usr/bin/env python3 /usr/share/hotspot-hub/app/hotspot-hub.py "$@"
fi
exec /usr/bin/env python3 /usr/share/hotspot-hub/app/hotspot-hub-flet.py "$@"
EOF
  install -Dm755 hotspot-hub-launcher "$pkgdir/usr/bin/hotspot-hub"
  printf '#!/usr/bin/env bash\nexec /usr/bin/env python3 /usr/share/hotspot-hub/app/hotspot-hub.py "$@"\n' > hotspot-hub-qt-launcher
  install -Dm755 hotspot-hub-qt-launcher "$pkgdir/usr/bin/hotspot-hub-qt"
  install -Dm755 hotspot-hub-flet.sh "$pkgdir/usr/bin/hotspot-hub-flet"
  install -Dm755 hotspot-hub-cli.py "$pkgdir/usr/bin/hotspot-hub-cli"
  install -Dm644 hotspot-hub.py "$pkgdir/usr/share/hotspot-hub/app/hotspot-hub.py"
  install -Dm755 hotspot-hub-tray.py "$pkgdir/usr/share/hotspot-hub/app/hotspot-hub-tray.py"
  install -Dm755 hotspot-hub-flet.py "$pkgdir/usr/share/hotspot-hub/app/hotspot-hub-flet.py"
  install -Dm644 core/__init__.py core/config.py core/services.py "$pkgdir/usr/share/hotspot-hub/core/"
  install -Dm755 hotspot-on.sh "$pkgdir/usr/share/hotspot-hub/helpers/hotspot-on.sh"
  install -Dm755 hotspot-off.sh "$pkgdir/usr/share/hotspot-hub/helpers/hotspot-off.sh"
  install -Dm755 hotspot-channelsync.sh "$pkgdir/usr/local/bin/hotspot-channelsync.sh"
  install -Dm755 90-hotspot-channelsync "$pkgdir/etc/NetworkManager/dispatcher.d/90-hotspot-channelsync"
  install -Dm644 hotspot-channelsync.service "$pkgdir/etc/systemd/system/hotspot-channelsync.service"
  install -Dm644 99-hotspot.conf "$pkgdir/etc/sysctl.d/99-hotspot.conf"
  install -Dm644 99-hotspot-powersave.conf "$pkgdir/etc/NetworkManager/conf.d/99-hotspot-powersave.conf"
  install -Dm440 hotspot-hub.sudoers "$pkgdir/etc/sudoers.d/hotspot-hub"
  install -Dm644 hotspot-hub.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/hotspot-hub.svg"
  install -Dm644 hotspot-hub.svg "$pkgdir/usr/share/pixmaps/hotspot-hub.svg"
  install -Dm644 hotspot-hub.desktop "$pkgdir/usr/share/applications/hotspot-hub.desktop"
  install -Dm644 hotspot-hub-flet.desktop "$pkgdir/usr/share/applications/hotspot-hub-flet.desktop"
  install -Dm644 hotspot-hub-qt.desktop "$pkgdir/usr/share/applications/hotspot-hub-qt.desktop"
  install -Dm755 setup-profile.sh "$pkgdir/usr/share/hotspot-hub/setup-profile.sh"
}
